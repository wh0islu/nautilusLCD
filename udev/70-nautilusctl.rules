# Gives the user logged into the local session access to the Corsair Nautilus LCD.
#
# TAG+="uaccess": systemd-logind adds an ACL to /dev/hidrawN for the user of
# the active session, without changing owner/group and without needing root.
# The file must be numbered < 73, because 73-seat-late.rules is the rule
# that applies the ACLs for uaccess tags.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c57", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c55", TAG+="uaccess"
